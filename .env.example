# Hórus — public/runtime-safe configuration
# Never commit real values. NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
APP_URL="https://your-horus-domain.example"

# Server-only secrets. NEVER expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Payments — server-only
EFI_CLIENT_ID="YOUR_EFI_CLIENT_ID"
EFI_CLIENT_SECRET="YOUR_EFI_CLIENT_SECRET"
EFI_CERT_BASE64="YOUR_EFI_CERT_BASE64"
TOKEN_FORTUNUS="YOUR_TOKEN_FORTUNUS"
IDENTIFICADOR_CONTA="YOUR_IDENTIFICADOR_CONTA"
PIX_CHAVE="YOUR_PIX_CHAVE"
